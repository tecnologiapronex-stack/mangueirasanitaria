---
import { DOCUMENTOS, DOWNLOADS_LIBERADOS, CONTATO, whatsappUrl } from "../data/site";
import Icone from "./Icone.astro";
interface Props { compacto?: boolean; }
const { compacto = false } = Astro.props;
---
<div class:list={["docs", { compacto }]}>
  {compacto && <h3>Documentos</h3>}
  <ul>
    {DOCUMENTOS.map((d) => (
      <li class="doc">
        <span class="doc-ico"><Icone nome="doc" /></span>
        <span class="doc-txt">
          <strong>{d.titulo}</strong>
          {!compacto && <span class="muted pequeno">{d.descricao}</span>}
          <span class="muted pequeno">PDF · versão {d.versao}</span>
        </span>
        {DOWNLOADS_LIBERADOS ? (
          <a class="btn btn-sec" href={d.arquivo} download data-evento="file_download" data-arquivo={d.id}>Baixar</a>
        ) : (
          <a class="btn btn-sec" href={whatsappUrl(`Olá! Gostaria de receber o documento "${d.titulo}" (${d.versao}).`)} target="_blank" rel="noopener" data-evento="contact_click" data-canal="whatsapp" data-origem={`pedir_${d.id}`}>Pedir pelo WhatsApp</a>
        )}
      </li>
    ))}
  </ul>
  {!DOWNLOADS_LIBERADOS && <p class="pequeno muted">Os documentos são enviados pela equipe técnica. Você também pode pedir por <a href={`mailto:${CONTATO.email}?subject=${encodeURIComponent("Pedido de ficha técnica")}`} data-evento="contact_click" data-canal="email" data-origem="pedir_doc">{CONTATO.email}</a>.</p>}
</div>
<style>
  .docs { display: flex; flex-direction: column; gap: 12px; }
  .docs ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .doc { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: #fff; border: 1px solid var(--linha); border-radius: 10px; flex-wrap: wrap; }
  .doc-ico { width: 40px; height: 40px; border-radius: 8px; background: var(--azul-claro); color: var(--azul); display: flex; align-items: center; justify-content: center; flex: none; }
  .doc-ico :global(svg) { width: 22px; height: 22px; }
  .doc-txt { display: flex; flex-direction: column; gap: 2px; flex: 1 1 200px; min-width: 0; }
  .doc .btn { min-height: 42px; font-size: 15px; }
  .compacto h3 { margin-top: 12px; }
</style>
