---
import Base from "../layouts/Base.astro";
import Icone from "./Icone.astro";
import Migalhas from "./Migalhas.astro";
import TabelaTecnica from "./TabelaTecnica.astro";
import Faq from "./Faq.astro";
import FaixaContato from "./FaixaContato.astro";
import Documentos from "./Documentos.astro";
import { CONDICOES, CONFORMIDADE, AVISO_INDICACAO, FAMILIAS, LINHAS, type Linha } from "../data/site";
import { faqLd } from "../scripts/ld";

interface Props {
  linha: Linha["slug"];
  title: string;
  description: string;
  h1: string;
  abertura: string;
  ondeTitulo: string;
  onde: string;
  ondeLista?: string[];
  ondeNota?: string;
  importaTitulo: string;
  importa: { t: string; d: string }[];
  notaEspecial?: string;
  conexoesTexto: string;
  faq: { p: string; r: string }[];
  faixaTitulo: string;
}
const p = Astro.props;
const l = LINHAS.find((x) => x.slug === p.linha)!;
const outras = LINHAS.filter((x) => x.slug !== p.linha);
const orcamentoHref = `/orcamento?linha=${l.slug}`;
const produtoLd = {
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  name: `Mangueira sanitária ${l.nome}`,
  description: p.description,
  brand: { "@type": "Brand", name: l.nome },
  manufacturer: { "@id": "https://mangueirasanitaria.com.br/#organizacao" },
  image: `https://mangueirasanitaria.com.br/img/mangueira-u.webp`,
  variesBy: "https://schema.org/size",
};
---
<Base title={p.title} description={p.description} migalhas={[{ label: "Mangueiras", href: "/mangueiras-sanitarias" }, { label: l.nome }]} jsonld={[produtoLd, faqLd(p.faq)]}>
  <section class="hero">
    <div class="wrap"><Migalhas itens={[{ label: "Mangueiras", href: "/mangueiras-sanitarias" }, { label: l.nome }]} /></div>
    <div class="wrap hero-in" style="padding-top:32px">
      <div class="hero-txt">
        <img src={l.logo} alt={l.nome} class="logo-linha" />
        <span class="sobre">{l.segmento}</span>
        <h1>{p.h1}</h1>
        <p class="lead">{p.abertura}</p>
        <div class="botoes">
          <a class="btn btn-pri btn-lg" href={orcamentoHref}>Solicitar orçamento da {l.nome} <Icone nome="seta" /></a>
          <a class="btn btn-sec btn-lg" href="#tabela">Ver a tabela técnica</a>
        </div>
        <div class="destaques">
          <span>Bitolas {CONDICOES.bitolas}</span><span>Trabalho {CONDICOES.pressaoTrabalho}</span><span>Vácuo {CONDICOES.vacuo}</span><span>−30 a 120 °C</span>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="hero-img">{l.slug === "flexmilk"
          ? <img src="/img/mangueira-terminais.webp" alt="Mangueiras sanitárias de capa azul com terminais em aço inox conduzindo leite" width="516" height="504" fetchpriority="high" />
          : <img src="/img/mangueira-u.webp" alt={`Mangueira sanitária ${l.nome} de capa azul com terminais em aço inox`} width="572" height="353" fetchpriority="high" />}</div>
      </figure>
    </div>
  </section>

  <section class="secao" aria-labelledby="t-onde">
    <div class="wrap duas">
      <div class="pilha">
        <h2 id="t-onde">{p.ondeTitulo}</h2>
        <p class="lead">{p.onde}</p>
        {p.ondeLista && <ul class="lista-check">{p.ondeLista.map((i) => <li>{i}</li>)}</ul>}
        {p.ondeNota && <p class="nota">{p.ondeNota}</p>}
      </div>
      <div class="pilha">
        <h2>{p.importaTitulo}</h2>
        <ul class="lista-check">{p.importa.map((i) => <li><strong>{i.t}</strong>: {i.d}</li>)}</ul>
        {p.notaEspecial && <p class="nota">{p.notaEspecial}</p>}
      </div>
    </div>
  </section>

  <section class="secao branco" id="tabela" aria-labelledby="t-tabela">
    <div class="wrap pilha-lg">
      <div class="cab-secao">
        <h2 id="t-tabela">Tabela técnica</h2>
        <p>Fonte: DataSheet Pronex, janeiro de 2025. A mesma tabela vale para FlexMilk, FlexFood e FlexPharma.</p>
      </div>
      <TabelaTecnica />
    </div>
  </section>

  <section class="secao" aria-labelledby="t-comp">
    <div class="wrap duas">
      <div class="pilha">
        <h2 id="t-comp">Composição</h2>
        <p>Tubo liso de borracha branca EPDM ou butílica, 100% atóxica · Reforço em camadas têxteis de alta resistência com arame helicoidal embutido · Capa de borracha sintética azul · Marcação em letras brancas.</p>
        <p class="aviso">{CONFORMIDADE}</p>
        <div class="foto"><img src="/img/mangueira-corte.webp" alt="Corte da mangueira mostrando tubo interno branco, reforço e capa azul" width="390" height="111" loading="lazy" /></div>
      </div>
      <div class="pilha">
        <h2>Fornecimento</h2>
        <p>Mangotes sob medida: a Pronex corta a mangueira no comprimento informado e monta as conexões escolhidas para cada extremidade.</p>
        <h3 style="margin-top:12px">Conexões disponíveis para a {l.nome}</h3>
        <p>{p.conexoesTexto}</p>
        <div class="chips">{FAMILIAS.map((f) => <a href={`/conexoes/${f.slug}`}>{f.nome}</a>)}</div>
        <Documentos compacto />
      </div>
    </div>
  </section>

  <section class="secao-sm">
    <div class="wrap"><p class="aviso">{AVISO_INDICACAO}</p></div>
  </section>

  <Faq itens={p.faq} />

  <section class="secao-sm branco" aria-labelledby="t-outras">
    <div class="wrap pilha">
      <h2 id="t-outras" style="font-size:22px">Outras linhas</h2>
      <div class="grade">
        {outras.map((o) => (
          <a class="cartao" href={`/${o.slug}`}>
            <h3>{o.nome}</h3><span class="etiqueta">{o.segmento}</span><p>{o.resumo}</p>
          </a>
        ))}
        <a class="cartao" href="/mangueiras-sanitarias#comparar" data-evento="compare_lines" data-origem={l.slug}><h3>Comparar as linhas</h3><p>As três lado a lado.</p></a>
      </div>
    </div>
  </section>

  <FaixaContato titulo={p.faixaTitulo} texto={`O pedido já começa com a linha ${l.nome} selecionada.`} orcamentoHref={orcamentoHref} orcamentoLabel={`Solicitar orçamento da ${l.nome}`} origem={l.slug} />
</Base>

<style>
  .logo-linha { height: 64px; width: auto; object-fit: contain; object-position: left; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { font: 500 14px/1 var(--mono); padding: 10px 12px; border-radius: 8px; border: 1px solid var(--linha); background: #fff; text-decoration: none; color: var(--azul-escuro); }
  .chips a:hover { border-color: var(--azul); }
</style>
