---
import Base from "../layouts/Base.astro";
---
<Base title="Página não encontrada | Pronex" description="A página procurada não existe ou mudou de endereço." noindex>
  <section class="secao branco">
    <div class="wrap pilha" style="max-width:760px;padding-top:40px;padding-bottom:40px">
      <span class="sobre">Erro 404</span>
      <h1>Não encontramos esta página</h1>
      <p class="lead">O endereço pode ter mudado. Escolha um caminho abaixo ou peça ajuda à equipe.</p>
      <div class="botoes">
        <a class="btn btn-pri" href="/mangueiras-sanitarias">Mangueiras sanitárias</a>
        <a class="btn btn-sec" href="/conexoes">Conexões</a>
        <a class="btn btn-sec" href="/materiais-tecnicos">Fichas técnicas</a>
        <a class="btn btn-sec" href="/orcamento">Solicitar orçamento</a>
      </div>
    </div>
  </section>
</Base>
