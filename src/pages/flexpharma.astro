---
import PaginaLinha from "../components/PaginaLinha.astro";
---
<PaginaLinha
  linha="flexpharma"
  title="FlexPharma: mangueira sanitária farmacêutica e cosmética | Pronex"
  description='FlexPharma é a mangueira sanitária atóxica da Pronex para as indústrias farmacêutica e cosmética: sucção e descarga, de 3/4" a 3", tubo interno liso.'
  h1="FlexPharma: mangueira sanitária para as indústrias farmacêutica e cosmética"
  abertura="A FlexPharma é a mangueira sanitária atóxica da Pronex dedicada aos ambientes farmacêutico, biotecnológico e cosmético, onde a pureza e a higiene orientam cada etapa do processo. Ela transfere produtos líquidos entre tanques, reatores e envase, em sucção ou descarga."
  ondeTitulo="Onde a FlexPharma é usada"
  onde="Áreas de produção farmacêutica, biotecnológica e cosmética, na transferência de produtos líquidos entre tanques, reatores e envase."
  importaTitulo="Necessidades dos segmentos farmacêutico e cosmético"
  importa={[
    { t: "Material em contato com o produto", d: "tubo liso de borracha branca EPDM ou butílica, 100% atóxica. A Pronex informa o elastômero de cada fornecimento." },
    { t: "Documentação para a qualidade", d: "DataSheet com a ficha técnica completa e conformidade com FDA, BfR XXI cat. 2 e Regulamento CE 1935/2004, livre de ftalatos e BPA, declarada pelo Grupo Pronex." },
    { t: "Higienização e esterilização", d: "temperatura máxima de 120 °C; a ficha indica que a mangueira pode ser esterilizada a 130 °C por no máximo 30 minutos. Informe o seu procedimento (CIP, vapor, agentes e tempos) para avaliação." },
    { t: "Troca de lote", d: "a superfície interna lisa dificulta a aderência de resíduos." },
    { t: "Compatibilidade com o produto", d: "a ficha cita álcool até 98% entre os fluidos indicados. Formulações cosméticas e farmacêuticas variam muito; a compatibilidade é avaliada pela equipe técnica para cada produto." },
  ]}
  notaEspecial="A FlexPharma não é apresentada como atendendo USP Class VI, ASME BPE, 3-A ou como autoclavável. Para requisitos específicos de validação, consulte a equipe técnica."
  conexoesTexto="O espigão, parte da conexão em contato com o produto, é de aço inox 316."
  faq={[
    { p: "A FlexPharma pode ser esterilizada?", r: "A ficha técnica indica que a mangueira pode ser esterilizada a 130 °C por no máximo 30 minutos. Informe o método e o ciclo usados na sua planta para a equipe confirmar a adequação." },
    { p: "Quais documentos acompanham a mangueira?", r: "O DataSheet com a ficha técnica. Para outros documentos exigidos pela sua qualidade, fale com a equipe técnica." },
    { p: "A FlexPharma serve para produtos cosméticos?", r: "A linha é dedicada aos ambientes farmacêutico e cosmético. A compatibilidade com cada formulação é avaliada pela equipe técnica a partir das informações do produto." },
    { p: "Qual a diferença entre FlexPharma e as outras linhas?", r: "A construção e a ficha técnica são as mesmas. A FlexPharma é a linha dedicada aos ambientes farmacêutico e cosmético." },
  ]}
  faixaTitulo="Especifique a FlexPharma para o seu processo"
/>
