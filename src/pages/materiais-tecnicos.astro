---
import Base from "../layouts/Base.astro";
import Migalhas from "../components/Migalhas.astro";
import Faq from "../components/Faq.astro";
import FaixaContato from "../components/FaixaContato.astro";
import Documentos from "../components/Documentos.astro";
import { CONDICOES } from "../data/site";
import { faqLd } from "../scripts/ld";
const crumbs = [{ label: "Materiais técnicos" }];
const resumo = [
  ["Uso", CONDICOES.uso],
  ["Tubo interno", "Borracha branca lisa, EPDM ou butílica, atóxica"],
  ["Reforço", "Camadas têxteis e arame helicoidal embutido"],
  ["Capa", "Borracha sintética azul"],
  ["Pressão de trabalho / ruptura", `${CONDICOES.pressaoTrabalho} / ${CONDICOES.pressaoRuptura}`],
  ["Temperatura de trabalho", CONDICOES.temperatura],
  ["Esterilização", "Até 130 °C por no máximo 30 minutos"],
  ["Vácuo", CONDICOES.vacuo],
  ["Bitolas", '3/4", 1", 1.1/2", 2" e 3"'],
];
const faq = [
  { p: "As três linhas têm a mesma construção?", r: "Sim. A ficha técnica é a mesma para FlexMilk, FlexFood e FlexPharma. Cada linha é apresentada para um ambiente de processo." },
  { p: "O tubo interno é EPDM ou butil?", r: "A ficha cita os dois materiais. O elastômero de cada fornecimento é informado pela Pronex na proposta." },
  { p: "A mangueira pode ser esterilizada?", r: "A ficha indica esterilização a até 130 °C por no máximo 30 minutos. Para a sua rotina de limpeza, consulte a equipe técnica." },
  { p: "A mangueira é aprovada pela FDA?", r: "A ficha declara conformidade com F.D.A., BfR XXI categoria 2, Regulamento CE 1935/2004 e 2023/2006 e DM 21/03/1973, e ausência de ftalatos e BPA. Essa conformidade é declarada pelo Grupo Pronex. Para a documentação de um pedido, fale com a equipe." },
  { p: "Qual o raio mínimo de curvatura?", r: 'Depende da bitola: de 40 mm na 3/4" a 150 mm na 3". Veja a tabela em <a href="/flexmilk#tabela">qualquer página de linha</a>.' },
  { p: "Qual o prazo de entrega?", r: "O prazo é informado na proposta, conforme a bitola, o comprimento e as conexões." },
  { p: "Como peço um orçamento?", r: 'Pelo <a href="/orcamento">montador de pedido</a>, que envia a especificação pelo WhatsApp ou e-mail, ou direto pelo telefone (11) 4114-9633.' },
];
---
<Base
  title="Fichas técnicas e materiais das mangueiras sanitárias | Pronex"
  description="Ficha técnica das mangueiras sanitárias FlexMilk, FlexFood e FlexPharma e do kit de conexão ConeX by Pronex. Resumo de pressão, temperatura, bitolas e perguntas frequentes."
  migalhas={crumbs}
  jsonld={[faqLd(faq)]}
>
  <section class="hero">
    <div class="wrap"><Migalhas itens={crumbs} /></div>
    <div class="wrap" style="padding-top:32px;padding-bottom:64px">
      <div class="hero-txt" style="max-width:820px">
        <span class="sobre">Materiais técnicos</span>
        <h1>Fichas técnicas e perguntas frequentes</h1>
        <p class="lead">Aqui ficam os documentos oficiais das linhas e das conexões, na versão vigente. Se precisar de um documento que não está na lista, peça à equipe técnica.</p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="t-docs">
    <div class="wrap duas">
      <div class="pilha">
        <h2 id="t-docs">Documentos</h2>
        <Documentos />
      </div>
      <div class="pilha">
        <h2>Resumo técnico</h2>
        <p class="muted pequeno">Comum às três linhas. Fonte: DataSheet Pronex, jan/2025.</p>
        <div class="tabela-wrap">
          <table class="tabela" style="min-width:0">
            <tbody>{resumo.map(([k, v]) => <tr><th scope="row" style="white-space:normal">{k}</th><td>{v}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="pequeno">A tabela completa por bitola fica nas <a href="/flexmilk#tabela">páginas das linhas</a>.</p>
      </div>
    </div>
  </section>

  <Faq itens={faq} titulo="Perguntas frequentes gerais" />
  <FaixaContato titulo="Não achou a resposta?" texto="Envie a sua dúvida para a equipe técnica junto com o pedido." origem="materiais" />
</Base>
