---
import Base from "../layouts/Base.astro";
import Migalhas from "../components/Migalhas.astro";
import Icone from "../components/Icone.astro";
import { CONTATO, FAMILIAS, LINHAS, TABELA } from "../data/site";
const crumbs = [{ label: "Orçamento" }];
const pontas = [...FAMILIAS.map((f) => ({ v: f.slug, l: f.nome })), { v: "outra", l: "Outra / não sei" }, { v: "sem", l: "Sem conexão (ponta livre)" }];
---
<Base
  title="Solicitar orçamento de mangueira sanitária | Pronex"
  description="Monte o pedido de mangueira sanitária FlexMilk, FlexFood ou FlexPharma com conexões Tri-Clamp, SMS, DIN, RJT, BSP, NPT ou Camlock e envie pelo WhatsApp ou e-mail para a equipe técnica da Pronex."
  migalhas={crumbs}
>
  <section class="hero">
    <div class="wrap"><Migalhas itens={crumbs} /></div>
    <div class="wrap" style="padding-top:28px;padding-bottom:40px">
      <div class="hero-txt" style="max-width:820px;gap:14px">
        <h1>Solicitar orçamento</h1>
        <p class="lead">Quatro etapas rápidas. No fim, o pedido abre no WhatsApp ou no seu e-mail já escrito, e você envia para a equipe técnica da Pronex. Se não souber algum dado, deixe em branco ou escolha "não sei".</p>
      </div>
    </div>
  </section>

  <section class="secao-sm">
    <div class="wrap orc">
      <form class="orc-form" novalidate>
        <ol class="passos" aria-label="Etapas">
          <li data-passo-ind="1" aria-current="step"><span>1</span> Produto</li>
          <li data-passo-ind="2"><span>2</span> Conexões</li>
          <li data-passo-ind="3"><span>3</span> Aplicação</li>
          <li data-passo-ind="4"><span>4</span> Contato</li>
        </ol>

        <fieldset data-passo="1">
          <legend>Produto</legend>
          <div class="campo">
            <span class="rotulo" id="r-linha">Linha de mangueira <em>obrigatório</em></span>
            <div class="opcoes" role="radiogroup" aria-labelledby="r-linha">
              {LINHAS.map((l) => <label class="opcao"><input type="radio" name="linha" value={l.nome} required /> <span><strong>{l.nome}</strong><small>{l.segmento}</small></span></label>)}
              <label class="opcao"><input type="radio" name="linha" value="Ainda não sei" /> <span><strong>Ainda não sei</strong><small>A equipe indica</small></span></label>
            </div>
          </div>
          <div class="linha2">
            <label class="campo">
              <span class="rotulo">Bitola <em>obrigatório</em></span>
              <select name="bitola" required>
                <option value="">Escolha</option>
                {TABELA.map((t) => <option value={t.bitola}>{t.bitola} (Ø interno {t.di} mm)</option>)}
                <option value="Não sei">Não sei</option>
              </select>
            </label>
            <label class="campo">
              <span class="rotulo">Comprimento de cada mangueira (m) <em>obrigatório</em></span>
              <input type="number" name="comprimento" min="0.1" step="0.1" inputmode="decimal" required />
              <small>Medida total, de ponta a ponta.</small>
            </label>
            <label class="campo">
              <span class="rotulo">Quantidade de mangueiras <em>obrigatório</em></span>
              <input type="number" name="quantidade" min="1" step="1" inputmode="numeric" value="1" required />
            </label>
          </div>
        </fieldset>

        <fieldset data-passo="2" hidden>
          <legend>Conexões</legend>
          <div class="linha2">
            <label class="campo">
              <span class="rotulo">Ponta A <em>obrigatório</em></span>
              <select name="pontaA" required>
                <option value="">Escolha</option>
                {pontas.map((p) => <option value={p.v}>{p.l}</option>)}
              </select>
            </label>
            <label class="campo">
              <span class="rotulo">Ponta B <em>obrigatório</em></span>
              <select name="pontaB" required>
                <option value="">Escolha</option>
                <option value="igual">Igual à ponta A</option>
                {pontas.map((p) => <option value={p.v}>{p.l}</option>)}
              </select>
            </label>
          </div>
          <div class="campo" data-se-rosca hidden>
            <span class="rotulo" id="r-rosca">Rosca: macho ou fêmea</span>
            <div class="opcoes" role="radiogroup" aria-labelledby="r-rosca">
              <label class="opcao"><input type="radio" name="rosca" value="Macho" /> <span><strong>Macho</strong></span></label>
              <label class="opcao"><input type="radio" name="rosca" value="Fêmea" /> <span><strong>Fêmea</strong></span></label>
              <label class="opcao"><input type="radio" name="rosca" value="Não sei" /> <span><strong>Não sei</strong></span></label>
            </div>
          </div>
          <label class="campo" data-se-din hidden>
            <span class="rotulo">Norma DIN</span>
            <select name="normaDin"><option value="">Escolha</option><option>DIN 11851</option><option>DIN 11864</option><option>Não sei</option></select>
          </label>
          <label class="campo">
            <span class="rotulo">Material da conexão</span>
            <select name="material">
              <option value="Conforme indicação da Pronex">Conforme indicação da Pronex</option>
              <option>Inox 304</option><option>Inox 316</option><option>Inox 316L</option>
            </select>
            <small>No kit padrão, o espigão é em inox 316 e a capa em inox 304.</small>
          </label>
          <p class="aviso pequeno">Medida nominal igual não garante encaixe. Depois de enviar o pedido, mande uma foto da conexão atual na mesma conversa.</p>
        </fieldset>

        <fieldset data-passo="3" hidden>
          <legend>Aplicação</legend>
          <label class="campo">
            <span class="rotulo">Fluido transportado <em>obrigatório</em></span>
            <input type="text" name="fluido" required placeholder="Ex.: leite cru, suco concentrado, álcool 70%" />
          </label>
          <div class="linha2">
            <label class="campo"><span class="rotulo">Temperatura de trabalho (°C)</span><input type="text" name="temperatura" placeholder="Mínima e máxima, se souber" /></label>
            <label class="campo"><span class="rotulo">Pressão de trabalho (bar)</span><input type="text" name="pressao" /></label>
          </div>
          <div class="campo">
            <span class="rotulo" id="r-succao">Trabalha em sucção?</span>
            <div class="opcoes" role="radiogroup" aria-labelledby="r-succao">
              <label class="opcao"><input type="radio" name="succao" value="Sim" /> <span><strong>Sim</strong></span></label>
              <label class="opcao"><input type="radio" name="succao" value="Não" /> <span><strong>Não</strong></span></label>
              <label class="opcao"><input type="radio" name="succao" value="Não sei" /> <span><strong>Não sei</strong></span></label>
            </div>
          </div>
          <label class="campo"><span class="rotulo">Rotina de limpeza</span><textarea name="limpeza" rows="2" placeholder="Produtos, concentração, temperatura e tempo"></textarea></label>
          <label class="campo"><span class="rotulo">Observações</span><textarea name="observacoes" rows="3"></textarea></label>
        </fieldset>

        <fieldset data-passo="4" hidden>
          <legend>Contato</legend>
          <div class="linha2">
            <label class="campo"><span class="rotulo">Nome <em>obrigatório</em></span><input type="text" name="nome" autocomplete="name" required /></label>
            <label class="campo"><span class="rotulo">Empresa <em>obrigatório</em></span><input type="text" name="empresa" autocomplete="organization" required /></label>
            <label class="campo"><span class="rotulo">CNPJ</span><input type="text" name="cnpj" inputmode="numeric" /></label>
            <label class="campo"><span class="rotulo">Cidade / UF</span><input type="text" name="cidade" autocomplete="address-level2" /></label>
          </div>
          <p class="pequeno muted">Este site não guarda os seus dados. O texto do pedido é montado no seu navegador e enviado por você pelo WhatsApp ou pelo seu e-mail. Veja a <a href="/politica-de-privacidade">Política de Privacidade</a>.</p>
        </fieldset>

        <div class="erro" role="alert" aria-live="assertive"></div>

        <div class="navegacao">
          <button type="button" class="btn btn-sec" data-voltar hidden>Voltar</button>
          <button type="button" class="btn btn-pri" data-avancar><span data-txt>Avançar</span> <Icone nome="seta" /></button>
        </div>

        <div class="envio" hidden>
          <h2>Pedido pronto</h2>
          <p>Escolha como enviar. O texto abre já escrito; é só confirmar o envio.</p>
          <div class="botoes">
            <a class="btn btn-wa btn-lg" data-enviar="whatsapp" target="_blank" rel="noopener"><Icone nome="wa" /> Enviar pelo WhatsApp</a>
            <a class="btn btn-pri btn-lg" data-enviar="email"><Icone nome="mail" /> Enviar por e-mail</a>
            <button type="button" class="btn btn-sec btn-lg" data-copiar>Copiar o texto</button>
          </div>
          <p class="pequeno muted">WhatsApp {CONTATO.whatsapp} · {CONTATO.email} · {CONTATO.telefone}</p>
          <details><summary>Ver o texto do pedido</summary><pre class="previa"></pre></details>
        </div>
      </form>

      <aside class="resumo" aria-labelledby="t-resumo">
        <h2 id="t-resumo">Resumo do pedido</h2>
        <dl class="resumo-lista"></dl>
        <p class="pequeno muted">Prefere falar direto? <a href={CONTATO.telefoneHref} data-evento="contact_click" data-canal="telefone" data-origem="orcamento">{CONTATO.telefone}</a></p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .orc { display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr) 320px; align-items: start; }
  @media (max-width: 960px) { .orc { grid-template-columns: 1fr; } }
  .orc-form { background: #fff; border: 1px solid var(--linha); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 22px; }
  @media (max-width: 640px) { .orc-form { padding: 20px 16px; } }
  .passos { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-size: 14px; color: var(--texto-2); }
  .passos li { display: flex; align-items: center; gap: 8px; padding-bottom: 10px; border-bottom: 3px solid var(--linha); }
  .passos span { width: 26px; height: 26px; border-radius: 50%; background: var(--fundo); border: 1px solid var(--linha); display: inline-flex; align-items: center; justify-content: center; font: 600 13px/1 var(--mono); flex: none; }
  .passos li[aria-current="step"], .passos li.feito { color: var(--tinta); border-bottom-color: var(--azul); font-weight: 600; }
  .passos li[aria-current="step"] span, .passos li.feito span { background: var(--azul); color: #fff; border-color: var(--azul); }
  @media (max-width: 560px) { .passos li { font-size: 0; justify-content: center; } }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  fieldset[hidden] { display: none; }
  legend { font-size: 22px; font-weight: 600; margin-bottom: 4px; padding: 0; }
  .campo { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .campo[hidden] { display: none; }
  .rotulo { font-weight: 600; font-size: 15px; }
  .rotulo em { font-style: normal; font-weight: 400; font-size: 12.5px; color: var(--texto-2); margin-left: 6px; }
  .campo small { color: var(--texto-2); font-size: 13.5px; }
  input[type="text"], input[type="number"], select, textarea { font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #c9d3dd; border-radius: 8px; background: #fff; color: var(--tinta); width: 100%; min-height: 48px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--azul); box-shadow: 0 0 0 3px rgba(0, 99, 196, 0.2); }
  [aria-invalid="true"] { border-color: #b42318 !important; }
  .linha2 { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .opcoes { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .opcao { display: flex; align-items: flex-start; gap: 10px; padding: 14px; border: 1px solid #c9d3dd; border-radius: 10px; cursor: pointer; }
  .opcao:has(input:checked) { border-color: var(--azul); background: var(--azul-claro); }
  .opcao input { margin-top: 4px; accent-color: var(--azul); width: 18px; height: 18px; }
  .opcao span { display: flex; flex-direction: column; }
  .opcao small { color: var(--texto-2); font-size: 13px; }
  .erro { color: #b42318; font-weight: 600; font-size: 15px; }
  .erro:empty { display: none; }
  .navegacao { display: flex; justify-content: space-between; gap: 12px; }
  .navegacao [data-avancar] { margin-left: auto; }
  .envio { display: flex; flex-direction: column; gap: 14px; padding: 22px; border-radius: 12px; background: var(--azul-claro); border: 1px solid var(--azul-borda); }
  .envio[hidden] { display: none; }
  .envio summary { cursor: pointer; color: var(--azul); font-weight: 600; }
  .previa { white-space: pre-wrap; font: 14px/1.5 var(--mono); background: #fff; border: 1px solid var(--linha); border-radius: 8px; padding: 14px; margin: 10px 0 0; }
  .resumo { position: sticky; top: 100px; background: #fff; border: 1px solid var(--linha); border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  @media (max-width: 960px) { .resumo { position: static; } }
  .resumo h2 { font-size: 18px; }
  .resumo-lista { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 8px 12px; font-size: 14.5px; }
  .resumo-lista dt { color: var(--texto-2); }
  .resumo-lista dd { margin: 0; font-weight: 500; overflow-wrap: anywhere; }
</style>

<script>
  import { CONTATO, FAMILIAS, LINHAS } from "../data/site";

  const form = document.querySelector<HTMLFormElement>(".orc-form")!;
  const passos = [...form.querySelectorAll<HTMLFieldSetElement>("[data-passo]")];
  const inds = [...form.querySelectorAll<HTMLLIElement>("[data-passo-ind]")];
  const btnVoltar = form.querySelector<HTMLButtonElement>("[data-voltar]")!;
  const btnAvancar = form.querySelector<HTMLButtonElement>("[data-avancar]")!;
  const erro = form.querySelector<HTMLDivElement>(".erro")!;
  const envio = form.querySelector<HTMLDivElement>(".envio")!;
  const resumo = document.querySelector<HTMLElement>(".resumo-lista")!;
  let atual = 0;
  let iniciado = false;

  const dl = (o: Record<string, unknown>) => {
    const w = window as unknown as { dataLayer?: unknown[] };
    (w.dataLayer = w.dataLayer || []).push(o);
  };

  // Pré-seleção vinda das páginas de linha e de conexão
  const qs = new URLSearchParams(location.search);
  const linhaQs = LINHAS.find((l) => l.slug === qs.get("linha"));
  if (linhaQs) form.querySelector<HTMLInputElement>(`input[name="linha"][value="${linhaQs.nome}"]`)!.checked = true;
  const pontaQs = qs.get("pontaA");
  if (pontaQs && FAMILIAS.some((f) => f.slug === pontaQs)) (form.elements.namedItem("pontaA") as HTMLSelectElement).value = pontaQs;

  const val = (n: string) => {
    const el = form.elements.namedItem(n) as HTMLInputElement | RadioNodeList | null;
    if (!el) return "";
    return String((el as HTMLInputElement).value ?? "").trim();
  };
  const nomePonta = (v: string) => (v === "igual" ? "Igual à ponta A" : FAMILIAS.find((f) => f.slug === v)?.nome ?? (v === "outra" ? "Outra / não sei" : v === "sem" ? "Sem conexão" : ""));
  const temRosca = () => ["bsp", "npt"].some((r) => [val("pontaA"), val("pontaB")].includes(r));
  const temDin = () => [val("pontaA"), val("pontaB")].includes("din");

  function dados() {
    const pontaB = val("pontaB") === "igual" ? val("pontaA") : val("pontaB");
    return [
      ["Linha", val("linha")],
      ["Bitola", val("bitola")],
      ["Comprimento", val("comprimento") && `${val("comprimento").replace(".", ",")} m`],
      ["Quantidade", val("quantidade")],
      ["Ponta A", nomePonta(val("pontaA"))],
      ["Ponta B", nomePonta(pontaB)],
      ["Rosca", temRosca() ? val("rosca") : ""],
      ["Norma DIN", temDin() ? val("normaDin") : ""],
      ["Material", val("material")],
      ["Fluido", val("fluido")],
      ["Temperatura", val("temperatura") && `${val("temperatura")} °C`],
      ["Pressão", val("pressao") && `${val("pressao")} bar`],
      ["Sucção", val("succao")],
      ["Limpeza", val("limpeza")],
      ["Observações", val("observacoes")],
      ["Nome", val("nome")],
      ["Empresa", val("empresa")],
      ["CNPJ", val("cnpj")],
      ["Cidade/UF", val("cidade")],
    ].filter(([, v]) => v) as [string, string][];
  }

  function texto() {
    const linhas = dados().map(([k, v]) => `• ${k}: ${v}`);
    return `Olá! Gostaria de um orçamento de mangueira sanitária montada.\n\n${linhas.join("\n")}\n\nEnviado pelo site mangueirasanitaria.com.br`;
  }

  function atualizarResumo() {
    resumo.innerHTML = "";
    const d = dados().filter(([k]) => !["Observações", "Limpeza", "CNPJ"].includes(k));
    if (!d.length) {
      resumo.innerHTML = "<dt>—</dt><dd>Preencha as etapas para ver o resumo.</dd>";
      return;
    }
    for (const [k, v] of d) {
      const dt = document.createElement("dt"); dt.textContent = k;
      const dd = document.createElement("dd"); dd.textContent = v;
      resumo.append(dt, dd);
    }
  }

  function condicionais() {
    form.querySelector<HTMLElement>("[data-se-rosca]")!.hidden = !temRosca();
    form.querySelector<HTMLElement>("[data-se-din]")!.hidden = !temDin();
  }

  function validar(i: number) {
    erro.textContent = "";
    const fs = passos[i];
    const req = [...fs.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]")];
    const vistos = new Set<string>();
    let primeiro: HTMLElement | null = null;
    for (const el of req) {
      if (vistos.has(el.name)) continue;
      vistos.add(el.name);
      let ok: boolean;
      if (el instanceof HTMLInputElement && el.type === "radio") {
        ok = !!fs.querySelector(`input[name="${el.name}"]:checked`);
      } else if (el instanceof HTMLInputElement && el.type === "number") {
        ok = Number(el.value) > 0;
      } else {
        ok = el.value.trim() !== "";
      }
      if (!(el instanceof HTMLInputElement && el.type === "radio")) el.setAttribute("aria-invalid", ok ? "false" : "true");
      if (!ok && !primeiro) primeiro = el;
    }
    const cnpj = val("cnpj").replace(/\D/g, "");
    if (i === 3 && cnpj && cnpj.length !== 14) {
      erro.textContent = "Confira o CNPJ. Ele precisa ter 14 números.";
      (form.elements.namedItem("cnpj") as HTMLElement).focus();
      return false;
    }
    if (primeiro) {
      const num = primeiro instanceof HTMLInputElement && primeiro.type === "number";
      erro.textContent = num ? "Informe um número maior que zero." : "Preencha os campos obrigatórios para continuar.";
      primeiro.focus();
      return false;
    }
    return true;
  }

  function mostrar(i: number) {
    atual = i;
    passos.forEach((p, k) => (p.hidden = k !== i));
    inds.forEach((li, k) => {
      li.classList.toggle("feito", k < i);
      if (k === i) li.setAttribute("aria-current", "step");
      else li.removeAttribute("aria-current");
    });
    btnVoltar.hidden = i === 0;
    btnAvancar.querySelector("[data-txt]")!.textContent = i === passos.length - 1 ? "Montar o pedido" : "Avançar";
    envio.hidden = true;
    dl({ event: "quote_step", passo: i + 1 });
  }

  function montarEnvio() {
    const t = texto();
    const wa = envio.querySelector<HTMLAnchorElement>('[data-enviar="whatsapp"]')!;
    const em = envio.querySelector<HTMLAnchorElement>('[data-enviar="email"]')!;
    wa.href = `https://wa.me/${CONTATO.whatsappDigitos}?text=${encodeURIComponent(t)}`;
    const assunto = `Orçamento site · ${val("empresa") || "cliente"} · ${val("linha")} ${val("bitola")}`.trim();
    em.href = `mailto:${CONTATO.email}?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(t)}`;
    envio.querySelector(".previa")!.textContent = t;
    envio.hidden = false;
    envio.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  form.addEventListener("input", () => {
    if (!iniciado) { iniciado = true; dl({ event: "quote_start" }); }
    condicionais();
    atualizarResumo();
    if (!envio.hidden) montarEnvio();
  });
  form.addEventListener("change", () => { condicionais(); atualizarResumo(); });
  btnVoltar.addEventListener("click", () => mostrar(Math.max(0, atual - 1)));
  btnAvancar.addEventListener("click", () => {
    if (!validar(atual)) return;
    if (atual < passos.length - 1) {
      mostrar(atual + 1);
      passos[atual].querySelector<HTMLElement>("input, select, textarea")?.focus();
    } else {
      montarEnvio();
    }
  });
  envio.querySelectorAll<HTMLAnchorElement>("[data-enviar]").forEach((a) =>
    a.addEventListener("click", () => dl({ event: "generate_lead", canal: a.dataset.enviar, linha: val("linha") })),
  );
  envio.querySelector<HTMLButtonElement>("[data-copiar]")!.addEventListener("click", async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(texto());
      b.textContent = "Texto copiado";
    } catch {
      b.textContent = "Não foi possível copiar";
    }
    setTimeout(() => (b.textContent = "Copiar o texto"), 2500);
  });

  condicionais();
  atualizarResumo();
</script>
